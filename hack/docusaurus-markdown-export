def extract_command_rows(content: str, known_slugs: set[str]) -> list[dict[str, str]]:
    """Read child names and target pages from a man page's ## COMMANDS table."""
    section = COMMANDS_SECTION_RE.search(content)
    if not section:
        return []

    children: list[dict[str, str]] = []
    for line in section.group(1).splitlines():
        if not line.lstrip().startswith("|"):
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) < 2:
            continue
        target_match = CMD_LINK_RE.search(" | ".join(cells))
        if not target_match:
            continue
        target = target_match.group(3).replace("\\-", "-")
        if target not in known_slugs:
            continue

        label_match = LABEL_LINK_RE.match(cells[0])
        label = label_match.group(1) if label_match else cells[0]
        label = LABEL_STYLE_RE.sub(lambda m: m.group(1) or m.group(2), label)
        label = LABEL_SECTION_RE.sub("", label).replace("\\-", "-").strip()
        if label.lower().startswith("podman-"):
            label = label[7:]
        label = label.replace("-", " ")
        if label:
            children.append({"slug": target, "label": label})
    return children


def build_command_tree(items: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Build the 2nd-level command tree with automatic categorization for new files."""
    by_slug: dict[str, dict[str, Any]] = {item["slug"].lower(): item for item in items}

    top_level_set: set[str] = set(TOP_LEVEL_COMMAND_CATEGORIES)
    prefix_parents: set[str] = set()
    for slug in by_slug:
        if slug.startswith("podman-"):
            parts = slug.split("-")
            if len(parts) >= 3:
                prefix_parents.add(f"{parts[0]}-{parts[1]}")
    top_level_set.update(slug for slug in prefix_parents if slug in by_slug)

    children_by_parent: dict[str, list[tuple[dict[str, Any], str]]] = {}
    children_seen: dict[str, set[str]] = {}
    claimed_slugs: set[str] = set()

    def add_child(parent_slug: str, child_item: dict[str, Any], custom_label: str = "") -> None:
        entries = children_by_parent.setdefault(parent_slug, [])
        seen = children_seen.setdefault(parent_slug, set())
        child_key = child_item["slug"].lower()
        if child_key not in seen:
            label = custom_label or command_label(child_item["slug"], parent_slug)
            entries.append((child_item, label))
            seen.add(child_key)
        claimed_slugs.add(child_key)

    # 1. Match by prefix (`podman-<parent>-<subcommand>`) and file patterns (`*.unit`, section 7)
    for item in items:
        slug = item["slug"].lower()
        if slug in top_level_set:
            continue

        if slug.startswith("podman-machine-os-") and "podman-machine-os" in by_slug:
            add_child("podman-machine-os", item)
            continue

        if (slug.endswith(".unit") or slug.startswith("podman-quadlet-")) and "podman-quadlet" in by_slug:
            if slug == "podman-quadlet-basic-usage":
                label = "basic usage"
            elif slug.endswith(".unit"):
                label = command_label(item["slug"])
            else:
                label = command_label(item["slug"], "podman-quadlet")
            add_child("podman-quadlet", item, label)
            continue

        if slug.startswith("podman-"):
            parts = slug.split("-")
            if len(parts) >= 3:
                candidate_parent = f"{parts[0]}-{parts[1]}"
                if candidate_parent != slug and candidate_parent in top_level_set and candidate_parent in by_slug:
                    add_child(candidate_parent, item)
                    continue

        if str(item.get("section")) == "7" and "podman-system" in by_slug:
            add_child("podman-system", item, command_label(item["slug"]))

    # 2. Merge logical subcommands from official COMMANDS tables
    for parent_slug, extras in LOGICAL_PARENT_SUBCOMMANDS.items():
        if parent_slug not in by_slug:
            continue
        for child_slug, child_label in extras:
            target = by_slug.get(child_slug.lower())
            if target:
                add_child(parent_slug, target, child_label)

    # 3. Also inspect parsed `## COMMANDS` tables on non-root parent pages so any newly added
    #    subcommand row in a Podman PR is automatically attached to its parent category.
    for parent_slug in list(top_level_set):
        if parent_slug in ("podman", "podmansh", "podman-remote"):
            continue
        parent_item = by_slug.get(parent_slug)
        if not parent_item:
            continue
        for row in parent_item.get("command_children", []):
            child_slug = row["slug"].lower()
            if child_slug in top_level_set or child_slug in claimed_slugs:
                continue
            target = by_slug.get(child_slug)
            if target:
                add_child(parent_slug, target, row["label"])

    # 4. Any brand-new standalone command not claimed by any parent is promoted to top level
    for item in items:
        slug = item["slug"].lower()
        if slug not in top_level_set and slug not in claimed_slugs:
            top_level_set.add(slug)

    top_level_slugs = [slug for slug in top_level_set if slug in by_slug]
    top_level_slugs.sort(key=lambda s: (0 if s == "podman" else 1 if s == "podmansh" else 2, s))

    result: list[dict[str, Any]] = []
    for slug in top_level_slugs:
        parent = by_slug[slug]
        raw_children = sorted(children_by_parent.get(slug, []), key=lambda pair: pair[1])
        subcommands = [
            {
                "slug": child["slug"],
                "title": child["title"],
                "label": label,
                "section": child["section"],
                "description": child["description"],
                "filename": child["filename"],
                "subcommands": [],
            }
            for child, label in raw_children
        ]
        result.append(
            {
                "slug": parent["slug"],
                "title": parent["title"],
                "label": command_label(parent["slug"]),
                "section": parent["section"],
                "description": parent["description"],
                "filename": parent["filename"],
                "subcommands": subcommands,
            }
        )
    return result


def load_man_pages(markdown_dir: Path, strict: bool = False) -> list[dict[str, Any]]:
    items: list[dict[str, Any]] = []
    for path in sorted(markdown_dir.iterdir()):
        if not path.is_file():
            continue
        parsed = slug_from_filename(path.name)
        if not parsed:
            continue
        slug, section = parsed
        raw = path.read_text(encoding="utf-8")
        if strict and UNEXPANDED_DIRECTIVE_RE.search(raw):
            raise SystemExit(
                f"Unexpanded @@option/@@include directive found in {path.name}; "
                "run hack/markdown-preprocess first."
            )
        title = slug
        header = HEADER_RE.search(raw)
        if header:
            title = header.group(1).replace("\\-", "-")
            section = header.group(2)
            raw = HEADER_RE.sub("", raw, count=1)
        description = extract_description(raw, slug)
        body = strip_name_heading(raw)
        items.append(
            {
                "slug": slug,
                "title": title,
                "section": section,
                "description": description,
                "filename": path.name,
                "command_children": [],
                "body": body,
            }
        )
    known_slugs = {item["slug"] for item in items}
    for item in items:
        item["command_children"] = extract_command_rows(item["body"], known_slugs)
    return items


def export_docs(markdown_dir: Path, output_dir: Path, revision: str, strict: bool = False) -> int:
    items = load_man_pages(markdown_dir, strict=strict)
    if not items:
        raise SystemExit(f"No man-page markdown found in {markdown_dir}")

    known_slugs = {item["slug"] for item in items}
    commands_dir = output_dir / "commands"
    commands_dir.mkdir(parents=True, exist_ok=True)

    for item in items:
        body = convert_setext(item["body"])
        body = fix_table_spacing(body)
        body = rewrite_links(body, known_slugs)
        body = sanitize_for_mdx(body)
        page = build_frontmatter(item) + body.strip() + "\n"
        safe_slug = SAFE_SLUG_RE.sub("-", item["slug"].lower())
        (commands_dir / f"{safe_slug}.md").write_text(page, encoding="utf-8", newline="\n")

    meta_items = [{k: v for k, v in item.items() if k != "body"} for item in items]
    manifest = {
        "revision": revision or "unknown",
        "generatedAt": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "commands": build_command_tree(meta_items),
        "totalCount": len(items),
    }
    (output_dir / "manifest.json").write_text(
        json.dumps(manifest, indent=2) + "\n", encoding="utf-8", newline="\n"
    )
    print(f"Wrote {len(items)} Docusaurus markdown files and manifest to {output_dir}")
    return len(items)


def main() -> None:
    args = parse_args()
    script_path = Path(__file__)
    markdown_dir = Path(args.markdown_dir) if args.markdown_dir else default_markdown_dir(script_path)
    if not markdown_dir.is_dir():
        raise SystemExit(f"Markdown directory does not exist: {markdown_dir}")

    missing_md = sorted(
        p.name for p in markdown_dir.glob("*.md.in") if not p.with_suffix("").is_file()
    )
    if missing_md:
        msg = (
            f"{len(missing_md)} .md.in template(s) are missing preprocessed .md output "
            f"(e.g. {missing_md[0]}); run hack/markdown-preprocess first."
        )
        if args.strict:
            raise SystemExit(f"error: {msg}")
        print(f"warning: {msg}", file=sys.stderr)

    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    export_docs(markdown_dir, output_dir, args.revision, strict=args.strict)


if __name__ == "__main__":
    main()
