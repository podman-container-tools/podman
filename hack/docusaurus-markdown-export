#!/usr/bin/env python3
#
# docusaurus-markdown-export
#
# Turns already-preprocessed man-page markdown (after hack/markdown-preprocess)
# into Docusaurus-ready .md files plus a CLI command-tree manifest.
#
"""Export Podman man-page markdown as Docusaurus CLI docs."""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ALLOWED_HTML_TAGS = frozenset(
    {
        "a",
        "sup",
        "sub",
        "br",
        "hr",
        "kbd",
        "code",
        "pre",
        "em",
        "strong",
        "b",
        "i",
        "u",
        "s",
        "span",
        "div",
        "p",
        "ul",
        "ol",
        "li",
        "table",
        "thead",
        "tbody",
        "tr",
        "th",
        "td",
        "details",
        "summary",
    }
)

MAN_FILE_RE = re.compile(r"^(?P<slug>.+)\.(?P<section>1|5|7)\.md$")
HEADER_RE = re.compile(r"^%\s+(\S+)\s+(\d+)", re.MULTILINE)
NAME_RE = re.compile(
    r"(?:##\s*NAME|(?:\r?\n|^)NAME\r?\n[=-]+)\s*\r?\n+([^\r\n]+)",
    re.IGNORECASE,
)
NAME_SPLIT_RE = re.compile(r"\s+-\s+")
SETEXT_RE = re.compile(r"^([A-Z0-9_ -]+)\r?\n([=-]{3,})\s*$", re.MULTILINE)
TABLE_BEFORE_RE = re.compile(r"(^[^|\r\n][^\r\n]*)\r?\n(\|[^\r\n]+\|)", re.MULTILINE)
TABLE_AFTER_RE = re.compile(r"(\|[^\r\n]+\|)\r?\n([^|\r\n])", re.MULTILINE)
MAN_LINK_RE = re.compile(
    r"\[([^\]]+)\]\(((?!https?://)[^)]*?)(podman(?:sh|-[a-zA-Z0-9_.-]+)?)\.(1|5|7)(?:\.md|\.md\.in)?(?:#([a-zA-Z0-9_-]+))?\)"
)
CMD_LINK_RE = re.compile(
    r"\[([^\]]+)\]\(((?!https?://)[^)]*?)(podman-[a-zA-Z0-9_.-]+)\.(1|5|7)(?:\.md|\.md\.in)?(?:#([a-zA-Z0-9_-]+))?\)"
)
COMMANDS_SECTION_RE = re.compile(
    r"^##\s+COMMANDS\s*\r?\n([\s\S]*?)(?=^##\s+|\Z)", re.MULTILINE | re.IGNORECASE
)
CONTAINERS_CONF_RE = re.compile(
    r"\[([^\]]+)\]\(((?!https?://)[^)]*?)containers\.conf\.5(?:\.md|\.md\.in)?\)"
)
ANGLE_RE = re.compile(r"\\?<(/?[a-zA-Z][^>\n]*)\\?>")
FENCE_RE = re.compile(r"^\s*```")
INDENT_RE = re.compile(r"^(?:\t|    )")
INLINE_CODE_RE = re.compile(r"(`+[^`]*`+)")
LABEL_LINK_RE = re.compile(r"\[([^\]]+)\]\([^)]+\)")
LABEL_STYLE_RE = re.compile(r"\*\*([^*]+)\*\*|`([^`]+)`")
LABEL_SECTION_RE = re.compile(r"\s*\([^)]*\)\s*$")
SAFE_SLUG_RE = re.compile(r"[^a-z0-9._-]")
UNEXPANDED_DIRECTIVE_RE = re.compile(r"^@@(?:option|include)\s+", re.MULTILINE)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--markdown-dir",
        default=None,
        help="Preprocessed man-page directory (default: docs/source/markdown next to this script, or CWD)",
    )
    parser.add_argument(
        "--output-dir",
        required=True,
        help="Directory to write commands/*.md and manifest.json",
    )
    parser.add_argument(
        "--revision",
        default=os.environ.get("PODMAN_DOCS_REVISION", ""),
        help="Git revision recorded in the manifest",
    )
    parser.add_argument(
        "--strict",
        action="store_true",
        help="Fail if any *.md.in template is missing its preprocessed .md file or has unexpanded directives",
    )
    return parser.parse_args()


def default_markdown_dir(script_path: Path) -> Path:
    hack_parent = script_path.resolve().parent
    candidate = hack_parent.parent / "docs" / "source" / "markdown"
    if candidate.is_dir():
        return candidate
    return Path.cwd()


def slug_from_filename(filename: str) -> tuple[str, str] | None:
    match = MAN_FILE_RE.match(filename)
    if not match:
        return None
    return match.group("slug"), match.group("section")


def extract_description(content: str, slug: str) -> str:
    match = NAME_RE.search(content)
    if not match:
        return f"Podman CLI reference documentation for {slug}"
    raw = match.group(1).replace("\\-", "-").strip()
    parts = NAME_SPLIT_RE.split(raw, maxsplit=1)
    if len(parts) > 1:
        return parts[1].strip()
    return raw


def strip_name_heading(content: str) -> str:
    return NAME_RE.sub("", content, count=1)


def convert_setext(content: str) -> str:
    return SETEXT_RE.sub(lambda m: f"\n## {m.group(1).strip()}\n\n", content)


def fix_table_spacing(content: str) -> str:
    content = TABLE_BEFORE_RE.sub(r"\1\n\n\2", content)
    content = TABLE_AFTER_RE.sub(r"\1\n\n\2", content)
    return content


def rewrite_links(content: str, known_slugs: set[str]) -> str:
    def man_sub(match: re.Match[str]) -> str:
        text, _path, target, _sec, anchor = match.groups()
        resolved = target
        if (
            resolved not in known_slugs
            and resolved == "podman-image-pull"
            and "podman-pull" in known_slugs
        ):
            resolved = "podman-pull"
        anchor_part = f"#{anchor}" if anchor else ""
        return f"[{text}](/docs/commands/{resolved}{anchor_part})"

    content = MAN_LINK_RE.sub(man_sub, content)
    content = CONTAINERS_CONF_RE.sub(
        r"[\1](https://github.com/containers/container-libs/blob/main/common/docs/containers.conf.5.md)",
        content,
    )
    return content


def sanitize_for_mdx(markdown: str) -> str:
    lines = markdown.splitlines()
    in_fence = False
    out: list[str] = []

    def replace_angle(match: re.Match[str]) -> str:
        full = match.group(0)
        inner = match.group(1)
        tag_name = inner.lstrip("/").split()[0].split("/")[0].lower()
        if not full.startswith("\\") and tag_name in ALLOWED_HTML_TAGS and "|" not in inner:
            return full
        cleaned = inner.rstrip("\\")
        return f"`<{cleaned}>`"

    for line in lines:
        if FENCE_RE.match(line):
            in_fence = not in_fence
            out.append(line)
            continue
        if in_fence or INDENT_RE.match(line):
            out.append(line)
            continue
        pieces = INLINE_CODE_RE.split(line)
        rebuilt = [
            part if part.startswith("`") else ANGLE_RE.sub(replace_angle, part)
            for part in pieces
        ]
        out.append("".join(rebuilt))
    return "\n".join(out)


def yaml_quote(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def build_frontmatter(item: dict[str, Any]) -> str:
    return "\n".join(
        [
            "---",
            f"id: {yaml_quote(item['slug'])}",
            f"title: {yaml_quote(item['title'])}",
            f"description: {yaml_quote(item['description'])}",
            f"slug: {yaml_quote('/commands/' + item['slug'])}",
            'displayed_sidebar: "docsSidebar"',
            "custom_edit_url: null",
            "---",
            "",
        ]
    )


def command_label(slug: str, parent_slug: str = "") -> str:
    lower_slug = slug.lower()
    if lower_slug == "podman":
        return "Podman"
    if parent_slug and lower_slug.startswith(parent_slug.lower() + "-"):
        return slug[len(parent_slug) + 1 :].replace("-", " ")
    if lower_slug.startswith("podman-"):
        return slug[7:].replace("-", " ")
    return slug.replace("-", " ")


