# -*- sh -*-
#
# Tests for the container update endpoint
#

podman pull $IMAGE &>/dev/null
podman rm -a -f &>/dev/null

# test that r_limits are preserved when omitted from update body (RHEL-178653)
# The bug: parseRLimits() returned empty non-nil slice when r_limits was absent,
# which triggered full rlimit replacement in container_internal.go, wiping existing rlimits.
t POST libpod/containers/create \
  Image=$IMAGE           \
  r_limits='[{"type":"nofile","soft":52191,"hard":127585}]' \
  201                    \
  .Id~[0-9a-f]\\{64\\}
cid=$(jq -r '.Id' <<<"$output")

# Verify ulimit is set at create time
t GET libpod/containers/$cid/json 200 \
  .HostConfig.Ulimits[0].Soft=52191

# Update an unrelated field (health log destination) without mentioning r_limits
t POST libpod/containers/$cid/update \
  health_log_destination=local \
  201

# Ulimits must survive the update
t GET libpod/containers/$cid/json 200 \
  .HostConfig.Ulimits[0].Soft=52191

t DELETE containers/$cid 204

t POST libpod/containers/create Image="$IMAGE" command='["sleep","120"]' \
  netns='{"nsmode":"none"}' 201
cid=$(jq -r '.Id' <<<"$output")
t POST "containers/$cid/update" \
  'BlkioDeviceReadBps=[{"Path":"/dev/null","Rate":1048576}]' \
  400 '.message~.*not a block device'

blkio_device=${PODMAN_TEST_BLKIO_DEVICE:-/dev/nullb0}
if root && [ -b "$blkio_device" ]; then
    t POST "containers/$cid/start" 204
    t GET "containers/$cid/json" 200 .State.Running=true
    if [[ $(jq -r '.State.Running' <<<"$output") != true ]]; then
        t DELETE "containers/$cid?force=true" 204
        return
    fi
    t POST "containers/$cid/update" \
      "BlkioDeviceReadBps=[{\"Path\":\"$blkio_device\",\"Rate\":1048576}]" \
      "BlkioDeviceWriteBps=[{\"Path\":\"$blkio_device\",\"Rate\":2097152}]" \
      200
    t GET "containers/$cid/json" 200 .HostConfig.BlkioDeviceReadBps[0].Rate=1048576
    like "$("$PODMAN_BIN" --root "$WORKDIR/server_root" exec "$cid" cat /sys/fs/cgroup/io.max)" \
      '.*rbps=1048576.*wbps=2097152.*' "both live rates set"

    t POST "containers/$cid/update" 'PidsLimit=64' 200
    t GET "containers/$cid/json" 200 \
      .HostConfig.PidsLimit=64 \
      .HostConfig.BlkioDeviceReadBps[0].Rate=1048576 \
      .HostConfig.BlkioDeviceWriteBps[0].Rate=2097152
    like "$("$PODMAN_BIN" --root "$WORKDIR/server_root" exec "$cid" cat /sys/fs/cgroup/io.max)" \
      '.*rbps=1048576.*wbps=2097152.*' "unrelated update preserves both live rates"

    printf '%s\n' '{"BlkioDeviceReadBps":null}' >"$WORKDIR/blkio-null.json"
    t POST "containers/$cid/update" "$WORKDIR/blkio-null.json" 200
    t GET "containers/$cid/json" 200 .HostConfig.BlkioDeviceReadBps[0].Rate=1048576

    t POST "containers/$cid/update" 'BlkioDeviceReadBps=[]' 200
    t GET "containers/$cid/json" 200 \
      .HostConfig.BlkioDeviceReadBps[0]=null \
      .HostConfig.BlkioDeviceWriteBps[0].Rate=2097152
    like "$("$PODMAN_BIN" --root "$WORKDIR/server_root" exec "$cid" cat /sys/fs/cgroup/io.max)" \
      '.*rbps=max.*wbps=2097152.*' "only the requested live rule is cleared"
fi
t DELETE "containers/$cid?force=true" 204

podman container rm -fa
