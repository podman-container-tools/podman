# -*- sh -*-
#
# secret-related tests
#

# secret create
t POST secrets/create Name=mysecret Data=c2VjcmV0 200\
    .ID~.* \

# secret create name already in use
t POST secrets/create Name=mysecret Data=c2VjcmV0 409

# secret create with Data that is invalid base64 must be rejected,
# and no secret should be created from it.
t POST secrets/create Name=b64plain Data=hunter2 400 \
    .message="secret data must be base64 encoded: illegal base64 data at input byte 4"
t GET secrets/b64plain 404

t POST secrets/create Name=b64garbage Data='c2VjcmV0!!!' 400 \
    .message="secret data must be base64 encoded: illegal base64 data at input byte 8"
t GET secrets/b64garbage 404

# url-safe base64 ('-' and '_') is not accepted; only standard base64 is.
# Pre-quoted because jsonify strips a single trailing '='.
t POST secrets/create Name=b64urlsafe Data='"_-8="' 400 \
    .message="secret data must be base64 encoded: illegal base64 data at input byte 0"
t GET secrets/b64urlsafe 404

# An extra '=' after valid base64 is rejected, not silently ignored.
# Pre-quoted: otherwise jsonify drops the '=' and sends valid "c2VjcmV0".
t POST secrets/create Name=b64padding Data='"c2VjcmV0="' 400 \
    .message="secret data must be base64 encoded: illegal base64 data at input byte 8"
t GET secrets/b64padding 404

# secret inspect
t GET secrets/mysecret 200 \
    .Spec.Name=mysecret \
    .Version.Index=1

# secret inspect non-existent secret
t GET secrets/bogus 404

# Check exists with existing secret
t GET libpod/secrets/mysecret/exists 204

# Check exists for non-existing secret
t GET libpod/secrets/bogus/exists 404

# secret list
t GET secrets 200 \
    length=1 \
    .[0].Spec.Name=mysecret \
    .[0].Version.Index=1

# secret list with filters
t GET secrets?filters='{"name":["mysecret"]}' 200 \
    length=1 \
    .[0].Spec.Name=mysecret \
    .[0].Version.Index=1

t GET secrets?filters='{"name":["mysecret2"]}' 200 \
    length=0 \

# secret libpod list with filters
t GET libpod/secrets/json?filters='{"name":["mysecret"]}' 200 \
    length=1 \
    .[0].Spec.Name=mysecret \

t GET libpod/secrets/json?filters='{"name":["mysecret2"]}' 200 \
    length=0 \

# secret list with unsupported filters
t GET secrets?filters='{"label":["xyz"]}' 500

#compat api list secrets sanity checks
t GET secrets?filters='garb1age}' 500 \
    .cause="invalid character 'g' looking for beginning of value"
t GET secrets?filters='{"label":["testl' 500 \
    .cause="unexpected end of JSON input"

#libpod api list secrets sanity checks
t GET libpod/secrets/json?filters='garb1age}' 500 \
    .cause="invalid character 'g' looking for beginning of value"
t GET libpod/secrets/json?filters='{"label":["testl' 500 \
    .cause="unexpected end of JSON input"

# secret with labels
t POST secrets/create Name=labeledsecret Data=c2VjcmV0 Labels='{"foo":"bar"}' 200
t GET secrets/labeledsecret 200 \
    .Spec.Labels.foo=bar

# secret rm
t DELETE secrets/mysecret 204
t DELETE secrets/labeledsecret 204

# secret rm non-existent secret
t DELETE secrets/bogus 404

# secret update not implemented
t POST secrets/mysecret/update 501

# compat api
t POST /secrets/create Name=foosecret Data=c2VjcmV0 200

t GET /secrets/foosecret 200 \
    .Spec.Name=foosecret

t DELETE /secrets/foosecret 204

# showsecret=true
t POST /secrets/create Name=hiddensecret Data=c2VjcmV0 200
t GET /secrets/hiddensecret?showsecret=true 200 \
    .Spec.Name=hiddensecret \
    .SecretData=null
t DELETE /secrets/hiddensecret 204

# libpod endpoint keeps the old behavior
t POST secrets/create Name=libpodsecret Data=c2VjcmV0 200
t GET libpod/secrets/libpodsecret/json?showsecret=true 200 \
    .Spec.Name=libpodsecret \
    .SecretData=secret
t DELETE libpod/secrets/libpodsecret 204

# compat create: bodies without Name, Data or Driver leave SecretCreateRequest nil - must be rejected instead of panicking
t POST secrets/create - 400 \
    .cause="missing secret name and data"
t POST secrets/create 400 \
    .cause="missing secret name and data"
# the top-level Labels field shadows SecretCreateRequest.Labels, so Labels alone does not allocate it
t POST secrets/create Labels='{"a":"b"}' 400 \
    .cause="missing secret name and data"
t POST secrets/create Foo=bar 400 \
    .cause="missing secret name and data"

# compat create: invalid input is a client error (400), not 500 (issue #30230)
t POST secrets/create Data=c2VjcmV0 400 \
    .message~".*be between 1 and 253 characters.*"

for badname in 'a/b' 'a,b' 'a=b'; do
    t POST secrets/create Name="$badname" Data=c2VjcmV0 400 \
        .message~".*can not include '=', '/', ','.*"
done

longname=$(printf 'a%.0s' {1..254})
t POST secrets/create Name=$longname Data=c2VjcmV0 400
t POST secrets/create Name=${longname:0:253} Data=c2VjcmV0 200   # boundary: 253 is fine
t DELETE secrets/${longname:0:253} 204

t POST secrets/create Name=emptydata Data='""' 400 \
    .message~".*secret data must be larger than 0.*"
t GET secrets/emptydata 404

t POST secrets/create Name=baddriver Data=c2VjcmV0 Driver='{"Name":"bla"}' 400 \
    .message~".*invalid driver.*"
t GET secrets/baddriver 404

# libpod/secrets/create: same classification
t POST "libpod/secrets/create?name=a/b" 400 \
    .message~".*can not include '=', '/', ','.*"
t POST "libpod/secrets/create?name=libempty" - 400 \
    .message~".*secret data must be larger than 0.*"
t POST "libpod/secrets/create?name=libbad&driver=bla" 400 \
    .message~".*invalid driver.*"
t POST "libpod/secrets/create?name=libflags&replace=true&ignore=true" 400 \
    .message~".*ignoreIfExists and replace cannot be used together.*"

# conflict is 409 on libpod too (was 500)
t POST "libpod/secrets/create?name=libdup" 200
t POST "libpod/secrets/create?name=libdup" 409 \
    .message~".*secret name in use.*"

t POST "libpod/secrets/create?name=libdup&driver=bla" 409
# ignore/replace on an existing name still succeed
t POST "libpod/secrets/create?name=libdup&ignore=true" 200
t POST "libpod/secrets/create?name=libdup&replace=true" 200
t DELETE libpod/secrets/libdup 204
